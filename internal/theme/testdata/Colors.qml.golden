pragma Singleton

import Quickshell
import QtQuick

// GENERATED by ~/.config/theme — edit themes/fixture.json and run `theme apply`.
//
// Theme.qml aliases these, so every widget keeps reading Theme.<colour> and
// only this file changes when the theme does. Quickshell watches its config
// directory, so writing this hot-reloads the bar.
Singleton {
	readonly property string themeName: "fixture"
	readonly property string themeLabel: "Fixture"

	readonly property color base: "#010101"
	readonly property color dim: "#020202"
	readonly property color surface: "#030303"
	readonly property color surfaceBright: "#040404"
	readonly property color outline: "#050505"
	readonly property color fg: "#060606"
	readonly property color fgDim: "#070707"
	readonly property color fgFaint: "#080808"
	readonly property color comment: "#090909"
	readonly property color red: "#0a0a0a"
	readonly property color green: "#0b0b0b"
	readonly property color yellow: "#0c0c0c"
	readonly property color blue: "#0d0d0d"
	readonly property color purple: "#0e0e0e"
	readonly property color cyan: "#0f0f0f"
	readonly property color orange: "#101010"
	readonly property color accent: "#111111"
}
